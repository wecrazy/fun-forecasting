# CoinGecko API
COINGECKO_API_KEY=your_coingecko_demo_key_here
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_KEY_HEADER=x-cg-demo-api-key

# CoinMarketCap API (optional fallback)
COINMARKETCAP_API_KEY=your_coinmarketcap_key_here

# Forecasting config
OPTUNA_TRIALS=60
HISTORY_DAYS=max
INCLUDE_BTC_ETH=1
DEFAULT_CURRENCY=usd

# GPU config: auto, true, false
USE_GPU=auto
